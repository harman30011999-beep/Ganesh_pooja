<%@ Page Language="VB" AutoEventWireup="false" CodeFile="Expenses.aspx.vb" Inherits="ExpensesPage" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Expenses | Ganesh Utsav</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /><link href="assets/css/admin-dashboard.css" rel="stylesheet" /></head><body class="admin-page"><form id="form1" runat="server"><nav class="topbar"><div class="container-fluid dashboard-width d-flex align-items-center justify-content-between"><a class="brand" href="Dashboard.aspx"><span class="brand-mark">ॐ</span><span><strong>Ganesh Utsav</strong><small>Committee console</small></span></a><div class="admin-nav"><a href="Donations.aspx">Donations</a><a class="active" href="Expenses.aspx">Expenses</a><a href="Committee.aspx">Committee</a><a href="Settings.aspx">Settings</a><a href="Login.aspx">Log out</a></div></div></nav><main class="dashboard-width page-content"><div class="page-intro"><div><p class="kicker">Money out</p><h1>Expenses</h1><p>Track approved spending and keep the festival fund visible.</p></div><a class="primary-action" href="Dashboard.aspx">Back to dashboard</a></div><div class="admin-panel mb-4"><div class="panel-title"><h2>Record an expense</h2></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Category</label><asp:DropDownList ID="ddlCategory" runat="server" CssClass="form-select"><asp:ListItem Text="Decoration" Value="Decoration" /><asp:ListItem Text="Food" Value="Food" /><asp:ListItem Text="Transport" Value="Transport" /><asp:ListItem Text="Music" Value="Music" /></asp:DropDownList></div><div class="col-md-4"><label class="form-label">Description</label><asp:TextBox ID="txtDescription" runat="server" CssClass="form-control" /></div><div class="col-md-4"><label class="form-label">Amount</label><asp:TextBox ID="txtAmount" runat="server" CssClass="form-control" TextMode="Number" /></div><div class="col-md-4"><label class="form-label">Vendor</label><asp:TextBox ID="txtVendor" runat="server" CssClass="form-control" /></div><div class="col-md-4"><label class="form-label">Expense Date</label><asp:TextBox ID="txtExpenseDate" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-md-4 d-flex align-items-end"><asp:Button ID="btnSave" runat="server" CssClass="btn btn-primary w-100" Text="Save Expense" OnClick="btnSave_Click" /></div></div></div><div class="admin-panel"><div class="panel-title"><h2>Expense history</h2></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Category</th><th>Description</th><th>Vendor</th><th>Amount</th><th>Status</th></tr></thead><tbody><asp:Repeater ID="rptExpenses" runat="server"><ItemTemplate><tr><td><%# Eval("Category") %></td><td><%# Eval("Description") %></td><td><%# Eval("Vendor") %></td><td class="amount"><%# Eval("Amount", "₹{0:n0}") %></td><td><span class="status"><%# Eval("Status") %></span></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></div></main></form></body></html>