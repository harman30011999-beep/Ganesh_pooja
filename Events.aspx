<%@ Page Language="VB" AutoEventWireup="false" CodeFile="Events.aspx.vb" Inherits="EventsPage" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Event Schedule | Ganesh Utsav</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /><link href="assets/css/admin-dashboard.css" rel="stylesheet" /></head>
<body class="admin-page"><form id="form1" runat="server"><nav class="topbar"><div class="container-fluid dashboard-width d-flex align-items-center justify-content-between"><a class="brand" href="Dashboard.aspx"><span class="brand-mark">ॐ</span><span><strong>Ganesh Utsav</strong><small>Committee console</small></span></a><div class="admin-nav"><a href="Donations.aspx">Donations</a><a class="active" href="Events.aspx">Schedule</a><a href="Expenses.aspx">Expenses</a><a href="Committee.aspx">Committee</a><a href="Settings.aspx">Settings</a><a href="Login.aspx">Log out</a></div></div></nav>
<main class="dashboard-width page-content"><div class="page-intro"><div><p class="kicker">Plan together</p><h1>Event schedule</h1><p>Add events manually or upload a CSV schedule for the public festival page.</p></div><a class="primary-action" href="Dashboard.aspx">Back to dashboard</a></div>
<div class="admin-panel mb-4"><div class="panel-title"><h2>Upload schedule</h2><span class="text-muted">CSV columns: EventName, EventDate, EventTime, Venue, Description, PosterUrl</span></div><div class="row g-3 align-items-end"><div class="col-md-8"><label class="form-label">Schedule CSV</label><asp:FileUpload ID="fileSchedule" runat="server" CssClass="form-control" /></div><div class="col-md-4"><asp:Button ID="btnUpload" runat="server" CssClass="btn btn-primary w-100" Text="Upload schedule" OnClick="btnUpload_Click" /></div></div><asp:Label ID="lblMessage" runat="server" CssClass="d-block mt-3 text-muted" /></div>
<div class="admin-panel mb-4"><div class="panel-title"><h2>Add one event</h2></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Event name</label><asp:TextBox ID="txtEventName" runat="server" CssClass="form-control" /></div><div class="col-md-4"><label class="form-label">Date</label><asp:TextBox ID="txtEventDate" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-md-4"><label class="form-label">Time</label><asp:TextBox ID="txtEventTime" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label">Venue</label><asp:TextBox ID="txtVenue" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label">Poster image URL</label><asp:TextBox ID="txtPosterUrl" runat="server" CssClass="form-control" /></div><div class="col-12"><label class="form-label">Description</label><asp:TextBox ID="txtDescription" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="2" /></div><div class="col-12"><asp:Button ID="btnAdd" runat="server" CssClass="btn btn-outline-primary" Text="Add event" OnClick="btnAdd_Click" /></div></div></div>
<div class="admin-panel"><div class="panel-title"><h2>Current schedule</h2></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Date</th><th>Event</th><th>Time</th><th>Venue</th><th>Description</th></tr></thead><tbody><asp:Repeater ID="rptEvents" runat="server"><ItemTemplate><tr><td><%# Eval("EventDate", "{0:dd MMM yyyy}") %></td><td><%# Server.HtmlEncode(Eval("EventName").ToString()) %></td><td><%# Server.HtmlEncode(Eval("EventTime").ToString()) %></td><td><%# Server.HtmlEncode(Eval("Venue").ToString()) %></td><td><%# Server.HtmlEncode(Eval("Description").ToString()) %></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></div></main></form></body></html>
